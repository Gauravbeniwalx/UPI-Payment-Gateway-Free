# Gmail account receiving HDFC Bank transaction emails
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_gmail_app_password

# UPI QR
UPI_ID=yourupi@hdfcbank
PAYEE_NAME=Your Business Name
BUSINESS_EMAIL=yourbusiness@gmail.com

# Database
DB_PATH=./hdfc_payments.db

# HDFC history + polling
SEARCH_DAYS=10
POLL_INTERVAL=3

# Optional: set the exact From address after checking one real HDFC email.
# Example:
# HDFC_EMAIL_FROM=alerts@hdfcbank.net

# Keep only incoming/credit notifications.
CREDIT_ONLY=true

# Deployment platform normally supplies this.
PORT=8000
